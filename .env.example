# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋되지 않습니다)

# --- 필수 ---

# 음성 기능 전부가 이 키를 씁니다: Realtime 세션 발급 · Whisper 전사 · TTS · 문장 파싱.
# 없으면 앱은 뜨지만 음성·파싱 경로가 조용히 폴백으로 빠집니다.
OPENAI_API_KEY=sk-...

# Prisma 접속 문자열. 로컬 개발은 아래 그대로 두면 됩니다.
DATABASE_URL="file:./dev.db"

# --- 선택 ---

# 동행 상세 화면의 지도. 없으면 지도 자리에 회색 박스가 나옵니다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 문장 파싱·요약에 쓸 모델. 비워두면 gpt-4o.
LLM_MODEL=
