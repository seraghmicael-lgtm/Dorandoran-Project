generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nickname     String
  lat          Float?
  lng          Float?
  neighborhood String?
  createdAt    DateTime @default(now())

  meetups       Meetup[]       @relation("CreatedMeetups")
  participation Participant[]
}

model Meetup {
  id            String   @id @default(cuid())
  activity      String
  startTime     String
  locationName  String?
  lat           Float?
  lng           Float?
  maxPeople     Int      @default(3)
  duration      String?  // 03_얼마나 걸릴까요에서 고른 소요 시간 표기("1시간 소요")
  goAnyway      Boolean  @default(true) // 05_몇 명이 함께할까요의 토글 — 최소 인원 미달이어도 성사할지
  status        String   @default("open") // open | matched | expired | cancelled
  message       String?  // 06_하실 말씀 — 게시판에 그대로 보이는 한마디
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())

  creatorId String
  creator   User   @relation("CreatedMeetups", fields: [creatorId], references: [id])

  participants Participant[]
}

model Participant {
  id       String   @id @default(cuid())
  meetupId String
  userId   String
  joinedAt DateTime @default(now())

  meetup Meetup @relation(fields: [meetupId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([meetupId, userId])
}
